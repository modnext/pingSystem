<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<l10n>
  <elements>
    <!-- Input Bindings -->
    <e k="input_PING_SYSTEM_CREATE" v="创建 / 移除标记" />

    <!-- Actions -->
    <e k="action_createPing" v="创建标记" />
    <e k="action_removePing" v="移除标记" />

    <!-- Ping settings -->
    <e k="settings_pingSystem_title" v="标记系统" />
    <e k="settings_pingDuration_title" v="标记显示时间" />
    <e k="settings_pingDuration_tooltip" v="设置标记对你的可见时长。在“持续显示”模式下，靠近标记会暂时隐藏其世界标记，离开后会重新显示。此设置仅对本地玩家生效，不会与服务器同步。" />
    <e k="settings_pingDuration_continuous" v="持续显示" />
    <e k="settings_pingLimit_title" v="每位玩家的标记数" />
    <e k="settings_pingLimit_tooltip" v="设置每位玩家可拥有的最大活动标记数。达到上限时，将替换最早的标记。只有主机可以更改此设置；该设置会保存在当前存档中。" />
    <e k="settings_pingVisibility_title" v="标记可见范围" />
    <e k="settings_pingVisibility_tooltip" v="设置标记是仅对同一农场的玩家可见，还是对所有农场的玩家可见。只有主机可以更改此设置；该设置会保存在当前存档中。" />
    <e k="settings_pingVisibility_sameFarm" v="仅同一农场" />
    <e k="settings_pingVisibility_allFarms" v="所有农场" />

    <!-- Warnings -->
    <e k="warning_pingNoTarget" v="未找到可放置标记的表面" />
  </elements>
</l10n>
